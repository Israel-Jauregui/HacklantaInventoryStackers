# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=inventory_pass
POSTGRES_DB=inventory_db

# Database URL for FastAPI (asyncpg for async support)
DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_pass@localhost:5432/inventory_db
